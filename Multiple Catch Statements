#include <iostream>
using namespace std;

int main() {
    int choice;

    cout << "Enter 1 or 2: ";
    cin >> choice;

    try {
        if (choice == 1)
            throw 10;

        if (choice == 2)
            throw 2.5;

        cout << "No exception";
    }

    catch (int x) {
        cout << "Integer exception: " << x;
    }

    catch (double x) {
        cout << "Double exception: " << x;
    }

    return 0;
}
