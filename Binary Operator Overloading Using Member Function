#include <iostream>
using namespace std;

class Number {
public:
    int x;

    Number(int a) {
        x = a;
    }

    Number operator+(Number n) {
        return Number(x + n.x);
    }
};

int main() {
    Number n1(10);
    Number n2(20);

    Number n3 = n1 + n2;

    cout << "Sum = " << n3.x;

    return 0;
}
